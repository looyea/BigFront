        "useAuthStore.getState().token",
        "useAuthStore()",
        "props 传",
        "Context"
      ],
      "answer": 0,
      "explanation": "非组件环境用 getState。"
    },
    {
      "stem": "persist 存 token 时用 partialize 的目的是？",
