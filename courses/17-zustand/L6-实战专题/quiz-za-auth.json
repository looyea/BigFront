      ],
      "answer": 3,
      "explanation": "减少风险与体积。"
    },
    {
      "stem": "401 响应常见的统一处理？",
      "options": [
        "忽略",
        "调用 logout 清态",
        "重试",
        "alert"
      ],
      "answer": 1,
      "explanation": "过期即登出复位。"
    },
    {
      "stem": "路由守卫判断登录用？",
