{
  "lessonId": "biome-config",
  "questions": [
    {
      "stem": "让编辑器能补全/校验配置字段靠什么？",
      "options": [
        "$schema 指向 schema.json",
        "package.json",
        ".gitignore",
        "tsconfig"
      ],
      "answer": 0,
      "explanation": "schema 驱动补全。"
    },
    {
      "stem": "划定处理范围的字段是？",
      "options": [
        "extends",
        "files.include / ignore",
        "linter.rules",
        "formatter.enabled"
      ],
      "answer": 1,
      "explanation": "files 区圈定谁被管。"
    },
    {
      "stem": "linter.rules.recommended:true 的含义？",
      "options": [
        "仅格式",
        "全开所有规则",
        "只开官方推荐集（低噪音）",
        "全关"
      ],
      "answer": 2,
      "explanation": "起手基线。"
    },
    {
      "stem": "想更激进地全开规则用？",
      "options": [
        "every:true",
        "strict:true",
        "max:true",
        "all:true"
      ],
      "answer": 3,
      "explanation": "all 全开含高噪音。"
    },
    {
      "stem": "配置优先级从高到低？",
      "options": [
        "CLI>biome.json>默认",
        "默认>文件>CLI",
        "文件>CLI>默认",
        "都相等"
      ],
      "answer": 0,
      "explanation": "显式 CLI 最高。"
    },
    {
      "stem": "团队共享公共配置靠？",
      "options": [
        "复制粘贴",
        "extends 继承预设包",
        "软链接",
        "环境变量"
      ],
      "answer": 1,
      "explanation": "extends 指向公共 biome 包。"
    },
    {
      "stem": "语言级格式化/规则覆盖写在哪？",
      "options": [
        "vcs",
        "顶层 formatter",
        "javascript/typescript 分区",
        "files"
      ],
      "answer": 2,
      "explanation": "语言区可覆盖全局。"
    },
    {
      "stem": "遇到未知文件类型跳过不报错用？",
      "options": [
        "exclude",
        "skip",
        "files.include",
        "ignoreUnknown"
      ],
      "answer": 3,
      "explanation": "ignoreUnknown 控制。"
    },
    {
      "stem": "推荐的起手配置策略是？",
      "options": [
        "最小可用配置、踩到再补",
        "禁用 linter",
        "只开 all",
        "一上来抄满配"
      ],
      "answer": 0,
      "explanation": "按需增长降噪音。"
    },
    {
      "stem": "四大功能区不含下列哪个？",
      "options": [
        "organizeImports",
        "bundler",
        "formatter",
        "linter"
      ],
      "answer": 1,
      "explanation": "Biome 不做打包。"
    }
  ]
}
